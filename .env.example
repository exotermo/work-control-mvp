APP_ENV=local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=workcontrol
POSTGRES_USER=workcontrol
POSTGRES_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
SEED_DEV_DATA=false
DEMO_SIMULATOR=false
AUTH_MODE=dev

# AUTH_MODE=dev e permitido somente com APP_ENV=local. Para validar a API em
# OIDC local, execute-a no host conforme o runbook e use os valores abaixo.
# OIDC_ALLOWED_ISSUER=http://localhost:8180/realms/work-control-local
# OIDC_AUDIENCE=urn:work-control:api:local
# OIDC_REQUIRED_SCOPE=work-control.api
# OIDC_EXPECTED_TOKEN_TYPE=Bearer
# OIDC_SIGNING_ALGORITHMS=RS256

# Keycloak de referencia para desenvolvimento local (profile Compose `oidc`).
# Estas credenciais sao publicas e inseguras por definicao. Nunca reutilize fora
# de uma maquina de desenvolvimento.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=local-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=local-only-admin-password
